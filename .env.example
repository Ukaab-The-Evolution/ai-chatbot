# Development environment variables
# Copy this file to chatbot.env and add your actual API key

GEMINI_API_KEY=your_gemini_api_key_here

# Your Azure Speech Service subscription key
AZURE_SPEECH_KEY=your_azure_speech_service_key_here

# Your Azure region (e.g., eastus, westus2, northeurope, etc.)
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Set custom port for development
PORT=8000

# Optional: Enable debug mode
DEBUG=true
